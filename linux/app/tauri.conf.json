{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LimitFuel",
  "version": "1.0.1",
  "identifier": "com.innolope.limitfuel",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Claude and Codex usage in the tray",
    "longDescription": "LimitFuel shows your Claude and Codex plan usage and reset times in the Linux tray.",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] },
      "rpm": { "depends": ["libayatana-appindicator-gtk3"] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
